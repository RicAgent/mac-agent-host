<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.along.agents</string>
  <key>UserName</key><string>__USER__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>sleep 20; /Users/__USER__/.local/bin/agent boot</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/__USER__</string>
    <key>USER</key><string>__USER__</string>
    <key>PATH</key><string>/Users/__USER__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LANG</key><string>en_US.UTF-8</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/__USER__</string>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/__USER__/agents/logs/boot.log</string>
  <key>StandardErrorPath</key><string>/Users/__USER__/agents/logs/boot.log</string>
</dict>
</plist>
